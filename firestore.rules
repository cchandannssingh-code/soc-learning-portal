rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to validate userId matches path
    // Since we don't have Firebase Auth yet, we validate that the userId in data matches the path
    function isValidUserId(pathUserId, dataUserId) {
      return pathUserId == dataUserId;
    }

    // Online Users - allow read for all, write only if userId in path matches data
    match /online_users/{userId} {
      allow read: if true;
      allow create: if request.resource.data.userId is string &&
                    isValidUserId(userId, request.resource.data.userId) &&
                    request.resource.data.userName is string &&
                    request.resource.data.userName.size() <= 50 &&
                    request.resource.data.status in ["online", "offline"];
      
      allow update: if isValidUserId(userId, request.resource.data.userId) &&
                    // Only allow updating specific fields to prevent malicious changes
                    request.resource.data.size() <= resource.data.size() + 2 &&
                    // Validate status if provided
                    (!request.resource.data.status is string || 
                     request.resource.data.status in ["online", "offline"]) &&
                    // Validate userName if provided
                    (!request.resource.data.userName is string ||
                     request.resource.data.userName.size() <= 50);
      
      allow delete: if isValidUserId(userId, userId);
    }

    // Community Messages - allow read for all, create with validation
    match /community_messages/{messageId} {
      allow read: if true;
      allow create: if request.resource.data.userId is string &&
                    request.resource.data.userId.size() > 0 &&
                    request.resource.data.userName is string &&
                    request.resource.data.userName.size() <= 50 &&
                    request.resource.data.message is string &&
                    request.resource.data.message.size() <= 500 &&
                    request.resource.data.message.size() > 0;
      
      // No updates or deletes allowed for community messages
      allow update: if false;
      allow delete: if false;
    }

    // User Profiles - allow read for all, write only if userId in path matches data
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUserId(userId, request.resource.data.userId) &&
                    request.resource.data.displayName is string &&
                    request.resource.data.displayName.size() <= 25 &&
                    request.resource.data.displayName.size() > 0;
      
      allow update: if isValidUserId(userId, request.resource.data.userId) &&
                    request.resource.data.displayName is string &&
                    request.resource.data.displayName.size() <= 25;
      
      allow delete: if isValidUserId(userId, userId);
    }

    // Direct Conversations - allow read/write for participants only
    match /direct_conversations/{conversationId} {
      // Read: Only participants can read the conversation
      // FIXED: Use resource.data (existing document) instead of request.resource.data (incoming write)
      allow read: if resource.data.participants is list &&
                   resource.data.participants.size() == 2 &&
                   resource.data.participants.hasAny([userId]);
      
      allow create: if request.resource.data.participants is list &&
                    request.resource.data.participants.size() == 2 &&
                    request.resource.data.participants.hasAny([userId]) &&
                    request.resource.data.participantNames is map;
      
      allow update: if resource.data.participants is list &&
                    resource.data.participants.hasAny([userId]);
      
      allow delete: if resource.data.participants is list &&
                    resource.data.participants.hasAny([userId]);

      // Direct Messages subcollection
      match /messages/{messageId} {
        // Read: Only sender or users in readBy array can read
        // FIXED: Use resource.data (existing document) instead of request.resource.data (incoming write)
        allow read: if resource.data.senderId is string &&
                     resource.data.readBy is list &&
                     (resource.data.senderId == userId ||
                      resource.data.readBy.hasAny([userId]));
        
        allow create: if request.resource.data.senderId is string &&
                      request.resource.data.senderId.size() > 0 &&
                      request.resource.data.senderName is string &&
                      request.resource.data.senderName.size() <= 50 &&
                      request.resource.data.message is string &&
                      request.resource.data.message.size() <= 500 &&
                      request.resource.data.message.size() > 0 &&
                      request.resource.data.readBy is list &&
                      request.resource.data.readBy.size() > 0 &&
                      // Verify user is a participant in the parent conversation
                      exists(/databases/$(database)/documents/direct_conversations/$(conversationId)) &&
                      get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participants is list &&
                      get(/databases/$(database)/documents/direct_conversations/$(conversationId)).data.participants.hasAny([userId]);
        
        // Update: Only sender or users in readBy can update (for marking as read)
        allow update: if resource.data.senderId is string &&
                      resource.data.readBy is list &&
                      (resource.data.senderId == userId ||
                       resource.data.readBy.hasAny([userId]));
        
        allow delete: if resource.data.senderId == userId;
      }
    }

    // Announcements - read-only for users (no write access without auth)
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if false; // Admin-only (enable with Firebase Auth in future)
    }

    // Voice Calls - allow read/write for participants only
    match /voice_calls/{callId} {
      // Read: Only participants can read the call
      allow read: if resource.data.participants is list &&
                   resource.data.participants.hasAny([userId]);
      
      allow create: if request.resource.data.participants is list &&
                     request.resource.data.participants.size() == 2 &&
                     request.resource.data.participants.hasAny([userId]) &&
                     request.resource.data.participantNames is map &&
                     request.resource.data.initiatorId is string &&
                     request.resource.data.status in ["ringing", "connecting", "active", "ended", "failed", "rejected", "cancelled", "timeout"];
      
      allow update: if resource.data.participants is list &&
                     resource.data.participants.hasAny([userId]);
      
      allow delete: if resource.data.participants is list &&
                     resource.data.participants.hasAny([userId]);

      // Call Events subcollection
      match /events/{eventId} {
        // Read: Only participants of the parent call can read events
        allow read: if exists(/databases/$(database)/documents/voice_calls/$(callId)) &&
                     get(/databases/$(database)/documents/voice_calls/$(callId)).data.participants is list &&
                     get(/databases/$(database)/documents/voice_calls/$(callId)).data.participants.hasAny([userId]);
        
        // Create: Only participants can create events, and userId must match
        allow create: if request.resource.data.userId == userId &&
                       request.resource.data.type in ["offer", "answer", "ice-candidate", "end-call"] &&
                       exists(/databases/$(database)/documents/voice_calls/$(callId)) &&
                       get(/databases/$(database)/documents/voice_calls/$(callId)).data.participants is list &&
                       get(/databases/$(database)/documents/voice_calls/$(callId)).data.participants.hasAny([userId]);
        
        allow update: if false;
        allow delete: if false;
      }
    }
  }
}
